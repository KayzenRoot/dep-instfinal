# Dedicated Supabase project only. Leave blank for local UI smoke checks.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is accepted if the project has not migrated to publishable keys.
PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for server-owned video upload sessions and READY promotion; never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# The Auth user must also have admin-managed App Metadata dif_studio_owner=true.
SUPABASE_OWNER_USER_ID=
APP_ORIGIN=http://127.0.0.1:5173

# Authenticated Cloudinary image delivery. These values are read on the server only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=10

# Cloudflare R2 private video storage (server-only). Leave blank to disable V2 video uploads.
# Create a private bucket and a token scoped to Object Read & Write for that bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional; derived from R2_ACCOUNT_ID when blank.
R2_ENDPOINT=
# r2 (production) or memory (local tests only).
VIDEO_STORAGE_DRIVER=r2
# none (quarantine until worker), ffprobe (local/CI), or fixture (tests only).
VIDEO_PROBE_DRIVER=none
MAX_VIDEO_MB=200
VIDEO_PART_SIZE_MB=8
