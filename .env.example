# Dedicated Supabase project only. Leave blank for local UI smoke checks.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is accepted if the project has not migrated to publishable keys.
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_OWNER_USER_ID=
APP_ORIGIN=http://127.0.0.1:5173

# Authenticated Cloudinary image delivery. These values are read on the server only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=10
